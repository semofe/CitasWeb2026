# Copia este archivo como .env y completa los valores locales. No subas .env a Git.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=citasweb
DB_USER=postgres
DB_PASSWORD=change_me

# Usa una cadena aleatoria de 32 o más caracteres.
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_characters
JWT_EXPIRES_IN=24h

# Orígenes autorizados, separados por coma.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

EMAIL_PROVIDER=gmail
EMAIL_USER=your_email@example.com
EMAIL_PASSWORD=your_email_app_password

# Para proveedores SMTP personalizados se exige TLS implícito.
# Configure el puerto seguro del proveedor (normalmente 465).
EMAIL_HOST=smtp.example.com
EMAIL_PORT=465
